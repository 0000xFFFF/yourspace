# copy to .env and change every secret
POSTGRES_DB=yourspace
POSTGRES_USER=yourspace
POSTGRES_PASSWORD=change-me

RABBITMQ_USER=yourspace
RABBITMQ_PASSWORD=change-me

# 64+ random chars: openssl rand -hex 48
SESSION_SECRET=change-me

# models pulled by the ollama container (vision/captioning + text embeddings)
PULL_MODELS=moondream nomic-embed-text

RUST_LOG=info
